<% layout('/layouts/boilerplate') %>

<div class="page-header animate-in">
    <h1><i class="fas fa-rss me-2" style="color: var(--accent-rose);"></i>Live Crime News Feed</h1>
    <p class="subtitle">Real-time crime news from India — aggregated from multiple sources</p>
</div>

<!-- Source Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6 animate-in">
        <div class="stat-card blue">
            <div class="stat-icon"><i class="fas fa-newspaper"></i></div>
            <div class="stat-value"><%= newsData.totalResults %></div>
            <div class="stat-label">Total Articles</div>
        </div>
    </div>
    <div class="col-md-3 col-6 animate-in">
        <div class="stat-card purple">
            <div class="stat-icon"><i class="fas fa-database"></i></div>
            <div class="stat-value"><%= Object.values(newsData.sources).filter(v => v > 0).length %></div>
            <div class="stat-label">Active Sources</div>
        </div>
    </div>
    <div class="col-md-3 col-6 animate-in">
        <div class="stat-card cyan">
            <div class="stat-icon"><i class="fas fa-clock"></i></div>
            <div class="stat-value" style="font-size: 1.1rem;"><%= new Date(newsData.lastUpdated).toLocaleTimeString('en-IN') %></div>
            <div class="stat-label">Last Updated</div>
        </div>
    </div>
    <div class="col-md-3 col-6 animate-in">
        <div class="stat-card emerald">
            <div class="stat-icon"><i class="fas fa-sync-alt"></i></div>
            <div class="stat-value" id="refreshCountdown">60</div>
            <div class="stat-label">Auto-Refresh (sec)</div>
        </div>
    </div>
</div>

<!-- Source Badges -->
<div class="mb-3 animate-in">
    <span class="btn-outline-premium btn-sm me-1" style="display:inline-block; cursor:default;">
        <i class="fas fa-circle me-1" style="color: var(--accent-blue);font-size:6px;vertical-align:middle;"></i> GNews: <%= newsData.sources.gnews || 0 %>
    </span>
    <span class="btn-outline-premium btn-sm me-1" style="display:inline-block; cursor:default;">
        <i class="fas fa-circle me-1" style="color: var(--accent-purple);font-size:6px;vertical-align:middle;"></i> NewsData: <%= newsData.sources.newsdata || 0 %>
    </span>
    <span class="btn-outline-premium btn-sm me-1" style="display:inline-block; cursor:default;">
        <i class="fas fa-circle me-1" style="color: var(--accent-cyan);font-size:6px;vertical-align:middle;"></i> NewsAPI: <%= newsData.sources.newsapi || 0 %>
    </span>
    <span class="btn-outline-premium btn-sm" style="display:inline-block; cursor:default;">
        <i class="fas fa-circle me-1" style="color: var(--accent-rose);font-size:6px;vertical-align:middle;"></i> BBC: <%= newsData.sources.bbc || 0 %>
    </span>
</div>

<!-- News Grid -->
<div class="row g-3" id="newsGrid">
<% newsData.articles.forEach(function(article, idx) { %>
    <div class="col-lg-4 col-md-6 animate-in">
        <div class="glass-card" style="height: 100%; display: flex; flex-direction: column;">
            <% if(article.image) { %>
            <div style="width:100%; height:180px; border-radius: var(--radius-md); overflow:hidden; margin-bottom: 1rem;">
                <img src="<%= article.image %>" alt="" style="width:100%; height:100%; object-fit:cover;" onerror="this.parentElement.style.display='none';">
            </div>
            <% } %>
            <div style="flex: 1;">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span style="font-size:0.65rem; padding:2px 6px; border-radius:4px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px;
                        background: <%= article.provider==='gnews'?'rgba(59,130,246,0.12)' : article.provider==='newsdata'?'rgba(139,92,246,0.12)' : article.provider==='newsapi'?'rgba(6,182,212,0.12)' : 'rgba(244,63,94,0.12)' %>;
                        color: <%= article.provider==='gnews'?'var(--accent-blue)' : article.provider==='newsdata'?'var(--accent-purple)' : article.provider==='newsapi'?'var(--accent-cyan)' : 'var(--accent-rose)' %>;">
                        <%= article.source %>
                    </span>
                    <span style="font-size: 0.7rem; color: var(--text-muted);">
                        <i class="fas fa-clock me-1"></i><%= new Date(article.publishedAt).toLocaleDateString('en-IN', { day:'numeric', month:'short' }) %>
                    </span>
                </div>
                <h6 style="font-weight: 600; font-size: 0.9rem; line-height: 1.4; margin-bottom: 0.5rem;">
                    <a href="<%= article.url %>" target="_blank" style="color: var(--text-primary); text-decoration: none;">
                        <%= article.title %>
                    </a>
                </h6>
                <% if(article.description) { %>
                <p style="font-size: 0.78rem; color: var(--text-muted); line-height: 1.5; margin: 0;">
                    <%= article.description.substring(0, 150) %><%= article.description.length > 150 ? '...' : '' %>
                </p>
                <% } %>
            </div>
            <div style="margin-top: auto; padding-top: 0.75rem;">
                <a href="<%= article.url %>" target="_blank" class="btn btn-outline-premium btn-sm w-100">
                    <i class="fas fa-external-link-alt me-1"></i> Read Full Article
                </a>
            </div>
        </div>
    </div>
<% }); %>
</div>

<% if(newsData.articles.length === 0) { %>
<div class="glass-card text-center py-5 animate-in">
    <i class="fas fa-satellite-dish" style="font-size:3rem; color: var(--text-muted);"></i>
    <p style="color: var(--text-muted); margin-top:1rem;">No news articles available at the moment. Data will refresh automatically.</p>
</div>
<% } %>

<script>
// Auto-refresh countdown
let countdown = 60;
const el = document.getElementById('refreshCountdown');
setInterval(() => {
    countdown--;
    if (el) el.textContent = countdown;
    if (countdown <= 0) {
        window.location.reload();
    }
}, 1000);
</script>

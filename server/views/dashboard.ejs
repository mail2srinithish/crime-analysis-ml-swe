<% layout('/layouts/boilerplate') %>

<div class="page-header animate-in">
    <h1><i class="fas fa-chart-line me-2" style="color: var(--accent-blue);"></i>Crime Intelligence Dashboard</h1>
    <p class="subtitle">National overview of Indian crime statistics (IPC & SLL) &mdash; 2003 to 2026 &bull; Powered by ML</p>
</div>

<!-- Live News Ticker -->
<% if(liveNews && liveNews.length > 0) { %>
<div class="glass-card mb-3 py-2 px-3 animate-in" style="border-left: 3px solid var(--accent-rose);">
    <div class="d-flex align-items-center gap-2" style="overflow: hidden;">
        <span style="background: var(--accent-rose); color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 700; white-space: nowrap;">
            <i class="fas fa-rss me-1"></i>LIVE
        </span>
        <div style="overflow: hidden; white-space: nowrap; position: relative; flex: 1;">
            <div id="newsTicker" style="display: inline-block; animation: tickerScroll 30s linear infinite;">
                <% liveNews.forEach(function(n) { %>
                    <a href="<%= n.url %>" target="_blank" style="color: var(--text-secondary); text-decoration: none; margin-right: 3rem; font-size: 0.82rem;">
                        <i class="fas fa-circle" style="font-size: 4px; vertical-align: middle; color: var(--accent-rose); margin-right: 6px;"></i><%= n.title %>
                    </a>
                <% }); %>
            </div>
        </div>
        <a href="/livefeed" style="color: var(--accent-blue); font-size: 0.75rem; white-space: nowrap; text-decoration: none;">View All →</a>
    </div>
</div>
<style>
@keyframes tickerScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}
</style>
<% } %>

<!-- Automated OSINT Intelligence Alerts -->
<% if (osintAlerts && osintAlerts.length > 0) { %>
    <div class="row mb-3">
        <div class="col-12 animate-in">
            <% osintAlerts.forEach(alert => { %>
                <div class="alert d-flex align-items-center" role="alert" style="border: 1px solid <%= alert.urgency === 'CRITICAL' ? 'rgba(225, 29, 72, 0.3)' : 'rgba(217, 119, 6, 0.3)' %>; background: <%= alert.urgency === 'CRITICAL' ? 'rgba(225, 29, 72, 0.06)' : 'rgba(217, 119, 6, 0.06)' %>; padding: 0.75rem 1.25rem; border-radius: var(--radius-md);">
                    <% if (alert.urgency === 'CRITICAL') { %>
                        <i class="fas fa-radiation fa-spin me-3" style="color: var(--accent-rose); font-size: 1.5rem;"></i>
                    <% } else { %>
                        <i class="fas fa-triangle-exclamation me-3" style="color: var(--accent-orange); font-size: 1.5rem;"></i>
                    <% } %>
                    <div style="flex: 1;">
                        <span class="badge <%= alert.urgency === 'CRITICAL' ? 'bg-danger' : 'bg-warning text-dark' %> me-2"><%= alert.urgency %></span>
                        <strong style="color: var(--text-primary);">SYSTEM ALERT:</strong> Predictive models identify critical <strong style="<%= alert.urgency==='CRITICAL' ? 'color:var(--accent-rose);' : 'color:var(--accent-orange);' %>">+<%= alert.growth %>%</strong> IPC crime growth projected for <strong><%= alert.state %></strong> in the upcoming cycle. 
                    </div>
                    <a href="/statewise?state=<%= Object.keys(stateList ? stateList.find(s=>s.name===alert.state) || {} : {}).length > 0 ? stateList.find(s=>s.name===alert.state).code : 'mh' %>" class="btn btn-sm btn-outline-light ms-3">Investigate</a>
                </div>
            <% }); %>
        </div>
    </div>
<% } %>

<!-- Stat Cards Row -->
<div class="row g-3 mb-4">
    <div class="col-lg-3 col-md-6 animate-in">
        <div class="stat-card blue">
            <div class="stat-icon"><i class="fas fa-map-pin"></i></div>
            <div class="stat-value">36</div>
            <div class="stat-label">States & UTs Tracked</div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 animate-in">
        <div class="stat-card purple">
            <div class="stat-icon"><i class="fas fa-gavel"></i></div>
            <div class="stat-value" id="totalIPC">--</div>
            <div class="stat-label">Total IPC Crimes (2026)</div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 animate-in">
        <div class="stat-card cyan">
            <div class="stat-icon"><i class="fas fa-scale-balanced"></i></div>
            <div class="stat-value" id="totalSLL">--</div>
            <div class="stat-label">Total SLL Crimes (2026)</div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 animate-in">
        <div class="stat-card rose">
            <div class="stat-icon"><i class="fas fa-arrow-trend-up"></i></div>
            <div class="stat-value" id="trendPct">--</div>
            <div class="stat-label">Year-over-Year Change</div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-3 mb-4">
    <div class="col-lg-8 animate-in">
        <div class="chart-container" style="height: 100%;">
            <div class="chart-title"><span class="dot blue"></span> National Crime Trends (IPC vs SLL)</div>
            <canvas id="nationalTrendChart" style="max-height: 350px;"></canvas>
        </div>
    </div>
    <div class="col-lg-4 animate-in">
        <div class="chart-container" style="height: 100%;">
            <div class="chart-title"><span class="dot purple"></span> Top 5 States by IPC (2026)</div>
            <canvas id="top5Chart" style="max-height: 350px;"></canvas>
        </div>
    </div>
</div>

<!-- Map + Safety Scores -->
<div class="row g-3 mb-4">
    <div class="col-lg-7 animate-in">
        <div class="map-container">
            <div class="chart-title"><span class="dot cyan"></span> State-wise Crime Intensity Map</div>
            <div id="india-map"></div>
        </div>
    </div>
    <div class="col-lg-5 animate-in">
        <div class="glass-card" style="max-height: 530px; overflow-y: auto;">
            <div class="chart-title"><span class="dot emerald"></span> Safety Score Leaderboard</div>
            <% if(safetyScores && safetyScores.length > 0) { %>
            <table class="state-table">
                <thead>
                    <tr><th>#</th><th>State</th><th>Score</th><th>Risk</th></tr>
                </thead>
                <tbody>
                <% safetyScores.sort((a,b) => b.safety_score - a.safety_score).forEach(function(s, i) { %>
                    <tr>
                        <td><span class="rank-badge <%= i===0?'gold':i===1?'silver':i===2?'bronze':'default' %>"><%= i+1 %></span></td>
                        <td><a href="/statewise?state=<%= Object.keys(stateTable || {}).find(k => (stateTable||{})[k] === s.state) || '' %>" style="color:var(--text-primary); text-decoration:none;"><%= s.state %></a></td>
                        <td>
                            <span style="color: <%= s.safety_score > 60 ? 'var(--accent-emerald)' : s.safety_score > 30 ? 'var(--accent-amber)' : 'var(--accent-rose)' %>; font-weight: 700;">
                                <%= s.safety_score %>
                            </span><span style="color:var(--text-secondary);font-weight:500;">/100</span>
                        </td>
                        <td>
                            <span style="font-size:0.7rem; padding:2px 6px; border-radius:4px; 
                                background: <%= s.risk_label==='Very Low'?'rgba(16,185,129,0.12)' : s.risk_label==='Low'?'rgba(6,182,212,0.12)' : s.risk_label==='Medium'?'rgba(245,158,11,0.12)' : 'rgba(244,63,94,0.12)' %>;
                                color: <%= s.risk_label==='Very Low'?'var(--accent-emerald)' : s.risk_label==='Low'?'var(--accent-cyan)' : s.risk_label==='Medium'?'var(--accent-amber)' : 'var(--accent-rose)' %>;">
                                <%= s.risk_label %>
                            </span>
                        </td>
                    </tr>
                <% }); %>
                </tbody>
            </table>
            <% } else { %>
            <table class="state-table">
                <thead><tr><th>#</th><th>State / UT</th><th>IPC Crimes</th><th>SLL Crimes</th></tr></thead>
                <tbody id="stateRankings"></tbody>
            </table>
            <% } %>
        </div>
    </div>
</div>

<!-- Citizen Reports Panel -->
<div class="row g-3 mb-4">
    <div class="col-12 animate-in">
        <div class="glass-card" style="border-left: 3px solid var(--accent-rose);">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="chart-title mb-0">
                    <span class="dot rose"></span> Citizen Crime Reports (Live Intake)
                </div>
                <a href="/triage" class="btn btn-sm" style="background:var(--accent-rose);color:#fff;border-radius:8px;padding:0.35rem 1rem;font-size:0.82rem;">
                    <i class="fas fa-truck-medical me-1"></i> Open Triage Center
                </a>
            </div>
            <div class="row g-3 mt-2">
                <div class="col-6 col-md-3">
                    <div style="text-align:center;padding:0.75rem;background:rgba(37,99,235,0.05);border-radius:10px;">
                        <div style="font-size:1.6rem;font-weight:800;color:var(--accent-blue);"><%= complaintStats.total %></div>
                        <div style="font-size:0.75rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;">Total Reports</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div style="text-align:center;padding:0.75rem;background:rgba(225,29,72,0.05);border-radius:10px;">
                        <div style="font-size:1.6rem;font-weight:800;color:var(--accent-rose);"><%= complaintStats.critical %></div>
                        <div style="font-size:0.75rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;">Critical Alerts</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div style="text-align:center;padding:0.75rem;background:rgba(8,145,178,0.05);border-radius:10px;">
                        <div style="font-size:1.6rem;font-weight:800;color:var(--accent-cyan);"><%= complaintStats.pending %></div>
                        <div style="font-size:0.75rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;">Pending Review</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div style="text-align:center;padding:0.75rem;background:rgba(5,150,105,0.05);border-radius:10px;">
                        <div style="font-size:1.6rem;font-weight:800;color:var(--accent-emerald);"><%= complaintStats.today %></div>
                        <div style="font-size:0.75rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;">Filed Today</div>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2 mt-3">
                <a href="/complaint" class="btn btn-outline-premium btn-sm">
                    <i class="fas fa-file-signature me-1"></i> File a Report
                </a>
                <a href="/crime" class="btn btn-outline-premium btn-sm">
                    <i class="fas fa-list-check me-1"></i> View All Reports
                </a>
                <a href="/api/export/complaints" class="btn btn-outline-premium btn-sm">
                    <i class="fas fa-download me-1"></i> Export CSV
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Pie Charts + Export -->
<div class="row g-3 mb-4">
    <div class="col-lg-5 animate-in">
        <div class="chart-container">
            <div class="chart-title"><span class="dot emerald"></span> Top 10 States - IPC (2026)</div>
            <canvas id="ipcPieChart" style="max-height: 300px;"></canvas>
        </div>
    </div>
    <div class="col-lg-5 animate-in">
        <div class="chart-container">
            <div class="chart-title"><span class="dot rose"></span> Top 10 States - SLL (2026)</div>
            <canvas id="sllPieChart" style="max-height: 300px;"></canvas>
        </div>
    </div>
    <div class="col-lg-2 animate-in">
        <div class="glass-card text-center" style="height: 100%; display: flex; flex-direction: column; justify-content: center; gap: 1rem;">
            <div>
                <i class="fas fa-download" style="font-size:2rem; color: var(--accent-blue);"></i>
                <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.5rem;">Export Data</p>
            </div>
            <a href="/api/export/csv" class="btn btn-outline-premium btn-sm" id="export-national">
                <i class="fas fa-file-csv me-1"></i> National CSV
            </a>
            <a href="/compare" class="btn btn-outline-premium btn-sm">
                <i class="fas fa-code-compare me-1"></i> Compare
            </a>
            <a href="/statewise" class="btn btn-outline-premium btn-sm">
                <i class="fas fa-map me-1"></i> Deep Dive
            </a>
        </div>
    </div>
</div>

<script>
const ipcData = <%- JSON.stringify(ipcData) %>;
const sllData = <%- JSON.stringify(sllData) %>;
const stateTable = <%- JSON.stringify(locals.stateTable || {}) %>;
const years = [];
for (let y = 2003; y <= 2026; y++) years.push(String(y));

const nationalIPC = new Array(years.length).fill(0);
const nationalSLL = new Array(years.length).fill(0);
ipcData.forEach(s => s.reports.forEach((v, i) => { if(i < years.length) nationalIPC[i] += v; }));
sllData.forEach(s => s.reports.forEach((v, i) => { if(i < years.length) nationalSLL[i] += v; }));

const lastIPC = nationalIPC[nationalIPC.length - 1];
const lastSLL = nationalSLL[nationalSLL.length - 1];
const prevIPC = nationalIPC[nationalIPC.length - 2];
const yoyChange = (((lastIPC - prevIPC) / prevIPC) * 100).toFixed(1);
document.getElementById('totalIPC').textContent = (lastIPC / 1000000).toFixed(1) + 'M';
document.getElementById('totalSLL').textContent = (lastSLL / 1000000).toFixed(1) + 'M';
document.getElementById('trendPct').textContent = (yoyChange > 0 ? '+' : '') + yoyChange + '%';

Chart.defaults.color = '#475569';
Chart.defaults.borderColor = 'rgba(0,0,0,0.05)';

new Chart(document.getElementById('nationalTrendChart'), {
    type: 'line',
    data: {
        labels: years,
        datasets: [{
            label: 'IPC Crimes', data: nationalIPC,
            borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,0.1)',
            fill: true, tension: 0.4, pointRadius: 3, borderWidth: 2
        }, {
            label: 'SLL Crimes', data: nationalSLL,
            borderColor: '#8b5cf6', backgroundColor: 'rgba(139,92,246,0.08)',
            fill: true, tension: 0.4, pointRadius: 3, borderWidth: 2
        }]
    },
    options: { responsive: true, interaction: { intersect: false, mode: 'index' },
        plugins: { legend: { position: 'top', labels: { usePointStyle: true, padding: 15 } } },
        scales: { y: { ticks: { callback: v => (v/1000000).toFixed(1)+'M' }, grid: { color: 'rgba(0,0,0,0.04)' } }, x: { grid: { display: false } } }
    }
});

const stateIPC2026 = ipcData.map(s => ({ state: s.State, value: s.reports[s.reports.length-1] })).sort((a,b) => b.value - a.value);
const top5 = stateIPC2026.slice(0, 5);
new Chart(document.getElementById('top5Chart'), {
    type: 'bar',
    data: { labels: top5.map(s => s.state.length > 15 ? s.state.substring(0,12)+'...' : s.state),
        datasets: [{ label: 'IPC (2026)', data: top5.map(s => s.value), backgroundColor: ['#3b82f6','#8b5cf6','#06b6d4','#10b981','#f59e0b'], borderRadius: 6, borderSkipped: false }]
    },
    options: { responsive: true, indexAxis: 'y', plugins: { legend: { display: false } },
        scales: { x: { ticks: { callback: v => (v/1000).toFixed(0)+'K' }, grid: { color: 'rgba(0,0,0,0.04)' } }, y: { grid: { display: false } } }
    }
});

// Fallback state rankings table (if no safety scores)
const rankBody = document.getElementById('stateRankings');
if (rankBody) {
    const stateSLL2026 = {};
    sllData.forEach(s => { stateSLL2026[s.State] = s.reports[s.reports.length-1]; });
    stateIPC2026.forEach((s, i) => {
        const bc = i===0?'gold':i===1?'silver':i===2?'bronze':'default';
        rankBody.innerHTML += `<tr><td><span class="rank-badge ${bc}">${i+1}</span></td><td>${s.state}</td><td>${s.value.toLocaleString('en-IN')}</td><td>${(stateSLL2026[s.state]||0).toLocaleString('en-IN')}</td></tr>`;
    });
}

// Map
const stateCoords = {
    'Andhra Pradesh':[15.9,79.7],'Arunachal Pradesh':[27.1,93.6],'Assam':[26.2,92.9],'Bihar':[25.1,85.3],
    'Chhattisgarh':[21.3,81.6],'Goa':[15.3,74],'Gujarat':[22.3,71.2],'Haryana':[29.1,76.1],
    'Himachal Pradesh':[32.1,77.2],'Jharkhand':[23.6,85.3],'Karnataka':[15.3,75.7],'Kerala':[10.9,76.3],
    'Madhya Pradesh':[23.5,78],'Maharashtra':[19.7,75.7],'Manipur':[24.7,93.9],'Meghalaya':[25.5,91.4],
    'Mizoram':[23.2,92.9],'Nagaland':[26.2,94.6],'Odisha':[20.9,84],'Punjab':[31.1,75.3],
    'Rajasthan':[27,74.2],'Sikkim':[27.5,88.5],'Tamil Nadu':[11.1,78.7],'Telangana':[18.1,79],
    'Tripura':[23.9,91.9],'Uttar Pradesh':[27.2,80.9],'Uttarakhand':[30.1,79],'West Bengal':[22.9,87.9],
    'Delhi':[28.7,77.1],'Jammu and Kashmir':[33.8,76.6],'Chandigarh':[30.7,76.8],'Puducherry':[11.9,79.8]
};
const map = L.map('india-map', { scrollWheelZoom: false }).setView([22.5, 82], 5);
L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', { attribution: '&copy; CARTO', maxZoom: 8, minZoom: 4 }).addTo(map);
const maxCrime = Math.max(...stateIPC2026.map(s => s.value));
const stateSLL2026Map = {};
sllData.forEach(s => { stateSLL2026Map[s.State] = s.reports[s.reports.length-1]; });
stateIPC2026.forEach(s => {
    const c = stateCoords[s.state]; if (!c) return;
    const intensity = Math.max(0.2, s.value / maxCrime);
    L.circleMarker(c, { radius: 8 + intensity * 25, fillColor: `rgba(244,63,94,${intensity})`, color: 'rgba(244,63,94,0.6)', weight: 1, fillOpacity: 0.7 })
      .addTo(map).bindPopup(`<div style="font-family:Inter;color:#333;"><strong>${s.state}</strong><br>IPC: ${s.value.toLocaleString('en-IN')}<br>SLL: ${(stateSLL2026Map[s.state]||0).toLocaleString('en-IN')}</div>`);
});

// Pie charts
const pieColors = ['#3b82f6','#8b5cf6','#06b6d4','#10b981','#f59e0b','#f43f5e','#ec4899','#14b8a6','#a78bfa','#fb923c'];
new Chart(document.getElementById('ipcPieChart'), {
    type: 'doughnut',
    data: { labels: stateIPC2026.slice(0,10).map(s=>s.state), datasets: [{ data: stateIPC2026.slice(0,10).map(s=>s.value), backgroundColor: pieColors, borderColor: '#ffffff', borderWidth: 2 }] },
    options: { responsive: true, cutout: '55%', plugins: { legend: { position: 'right', labels: { usePointStyle: true, padding: 8, font: { size: 10 } } } } }
});
const sllArr = sllData.map(s => ({ state: s.State, value: s.reports[s.reports.length-1] })).sort((a,b) => b.value - a.value).slice(0,10);
new Chart(document.getElementById('sllPieChart'), {
    type: 'doughnut',
    data: { labels: sllArr.map(s=>s.state), datasets: [{ data: sllArr.map(s=>s.value), backgroundColor: pieColors, borderColor: '#ffffff', borderWidth: 2 }] },
    options: { responsive: true, cutout: '55%', plugins: { legend: { position: 'right', labels: { usePointStyle: true, padding: 8, font: { size: 10 } } } } }
});
</script>

<% if(success && success.length){ %>
    <div class="alert alert-premium alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-circle-check me-2"></i><%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>
<% if(warning && warning.length){ %>
    <div class="alert alert-premium alert-warning alert-dismissible fade show" role="alert">
        <i class="fas fa-triangle-exclamation me-2"></i><%= warning %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>
<% if(error && error.length){ %>
    <div class="alert alert-premium alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-circle-xmark me-2"></i><%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>
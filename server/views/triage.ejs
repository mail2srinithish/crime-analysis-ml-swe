<% layout('/layouts/boilerplate') %>

<div class="page-header animate-in">
    <h1><i class="fas fa-truck-medical me-2" style="color:var(--accent-rose);"></i>Smart Dispatch — Triage Center</h1>
    <p class="subtitle">AI-classified citizen crime reports &mdash; manage, prioritise, and resolve</p>
</div>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-lg col-md-4 col-6 animate-in">
        <div class="stat-card blue">
            <div class="stat-icon"><i class="fas fa-file-lines"></i></div>
            <div class="stat-value"><%= stats.total %></div>
            <div class="stat-label">Total Reports</div>
        </div>
    </div>
    <div class="col-lg col-md-4 col-6 animate-in">
        <div class="stat-card rose">
            <div class="stat-icon"><i class="fas fa-radiation"></i></div>
            <div class="stat-value"><%= stats.critical %></div>
            <div class="stat-label">Critical Alerts</div>
        </div>
    </div>
    <div class="col-lg col-md-4 col-6 animate-in">
        <div class="stat-card cyan">
            <div class="stat-icon"><i class="fas fa-clock"></i></div>
            <div class="stat-value"><%= stats.pending %></div>
            <div class="stat-label">Pending</div>
        </div>
    </div>
    <div class="col-lg col-md-4 col-6 animate-in">
        <div class="stat-card emerald">
            <div class="stat-icon"><i class="fas fa-circle-check"></i></div>
            <div class="stat-value"><%= stats.resolved %></div>
            <div class="stat-label">Resolved</div>
        </div>
    </div>
    <div class="col-lg col-md-4 col-6 animate-in">
        <div class="stat-card purple">
            <div class="stat-icon"><i class="fas fa-calendar-day"></i></div>
            <div class="stat-value"><%= stats.today %></div>
            <div class="stat-label">Today</div>
        </div>
    </div>
</div>

<!-- Critical Banner -->
<% if(stats.critical > 0) { %>
<div class="glass-card mb-4 animate-in" style="border-left:4px solid var(--accent-rose); background:rgba(225,29,72,0.04);">
    <div class="d-flex align-items-center gap-3">
        <i class="fas fa-radiation fa-spin" style="color:var(--accent-rose);font-size:1.6rem;"></i>
        <div>
            <strong style="color:var(--accent-rose);">EMERGENCY DISPATCH:</strong>
            <span style="color:var(--text-primary);"> <%= stats.critical %> CRITICAL report(s) require immediate attention.</span>
        </div>
        <a href="/triage?priority=CRITICAL" class="btn btn-sm ms-auto" style="background:var(--accent-rose);color:#fff;border-radius:8px;padding:0.4rem 1rem;">
            View Critical
        </a>
    </div>
</div>
<% } %>

<!-- Filters -->
<div class="glass-card mb-4 animate-in">
    <form method="get" action="/triage" class="form-premium">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label">Priority</label>
                <select name="priority" class="form-select form-select-sm">
                    <option value="all" <%= (!filters.priority||filters.priority==='all')?'selected':'' %>>All Priorities</option>
                    <option value="CRITICAL" <%= filters.priority==='CRITICAL'?'selected':'' %>>CRITICAL</option>
                    <option value="HIGH" <%= filters.priority==='HIGH'?'selected':'' %>>HIGH</option>
                    <option value="MEDIUM" <%= filters.priority==='MEDIUM'?'selected':'' %>>MEDIUM</option>
                    <option value="LOW" <%= filters.priority==='LOW'?'selected':'' %>>LOW</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="all" <%= (!filters.status||filters.status==='all')?'selected':'' %>>All Status</option>
                    <option value="Pending" <%= filters.status==='Pending'?'selected':'' %>>Pending</option>
                    <option value="Under Review" <%= filters.status==='Under Review'?'selected':'' %>>Under Review</option>
                    <option value="Resolved" <%= filters.status==='Resolved'?'selected':'' %>>Resolved</option>
                    <option value="Closed" <%= filters.status==='Closed'?'selected':'' %>>Closed</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">State</label>
                <select name="state" class="form-select form-select-sm">
                    <option value="all">All States</option>
                    <% stateList.forEach(s => { %>
                    <option value="<%= s.name %>" <%= filters.state===s.name?'selected':'' %>><%= s.name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Crime Type</label>
                <select name="type" class="form-select form-select-sm">
                    <option value="all">All Types</option>
                    <option value="murder">Murder</option>
                    <option value="robbery">Robbery</option>
                    <option value="assault">Assault</option>
                    <option value="kidnapping">Kidnapping</option>
                    <option value="cybercrime">Cybercrime</option>
                    <option value="theft">Theft</option>
                    <option value="dowry">Dowry</option>
                    <option value="humantrafficking">Human Trafficking</option>
                    <option value="blackmailing">Blackmailing</option>
                    <option value="fakenews">Fake News</option>
                    <option value="other">Other</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-premium btn-sm w-100">
                    <i class="fas fa-filter me-1"></i>Filter
                </button>
            </div>
            <div class="col-md-2">
                <a href="/triage" class="btn btn-outline-premium btn-sm w-100">
                    <i class="fas fa-rotate-left me-1"></i>Reset
                </a>
            </div>
        </div>
    </form>
</div>

<!-- Reports Table -->
<div class="glass-card animate-in">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="chart-title mb-0">
            <span class="dot rose"></span>
            Showing <%= complaints.length %> report<%= complaints.length !== 1 ? 's' : '' %>
        </div>
        <a href="/api/export/complaints" class="btn btn-outline-premium btn-sm">
            <i class="fas fa-download me-1"></i>Export CSV
        </a>
    </div>

    <% if(complaints.length === 0) { %>
    <div class="text-center py-5">
        <i class="fas fa-inbox" style="font-size:3rem;color:var(--text-muted);"></i>
        <p style="color:var(--text-muted);margin-top:1rem;">No reports match the selected filters.</p>
    </div>
    <% } else { %>
    <div style="overflow-x:auto;">
    <table class="state-table">
        <thead>
            <tr>
                <th>Ref #</th>
                <th>Filed</th>
                <th>Reporter</th>
                <th>Location</th>
                <th>Type</th>
                <th>AI Priority</th>
                <th>Status</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        <% complaints.forEach(c => {
            const priorityColors = { CRITICAL:'#e11d48', HIGH:'#d97706', MEDIUM:'#0891b2', LOW:'#059669' };
            const statusColors = { 'Pending':'#d97706', 'Under Review':'#0891b2', 'Resolved':'#059669', 'Closed':'#94a3b8' };
            const pColor = priorityColors[c.aiPriority] || '#94a3b8';
            const sColor = statusColors[c.status] || '#94a3b8';
        %>
        <tr id="row-<%= c.id %>" style="<%= c.aiPriority==='CRITICAL' ? 'background:rgba(225,29,72,0.04);' : '' %>">
            <td>
                <code style="font-size:0.75rem;color:var(--accent-blue);font-weight:600;">
                    <%= c.refNumber || '—' %>
                </code>
            </td>
            <td style="white-space:nowrap;font-size:0.8rem;">
                <%= new Date(c.createdAt).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %><br>
                <span style="color:var(--text-muted);font-size:0.72rem;"><%= new Date(c.createdAt).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) %></span>
            </td>
            <td>
                <div style="font-weight:600;font-size:0.85rem;"><%= c.fullName %></div>
                <div style="font-size:0.75rem;color:var(--text-muted);"><%= c.email %></div>
            </td>
            <td style="font-size:0.82rem;">
                <% if(c.state) { %><span style="font-weight:600;"><%= c.state %></span><br><% } %>
                <%= c.district %>
            </td>
            <td>
                <span style="font-size:0.72rem;padding:2px 8px;border-radius:6px;background:rgba(244,63,94,0.1);color:var(--accent-rose);font-weight:600;text-transform:capitalize;">
                    <%= c.complaintType %>
                </span>
            </td>
            <td>
                <span style="display:inline-flex;align-items:center;gap:5px;font-size:0.75rem;padding:3px 9px;border-radius:6px;font-weight:700;background:<%- pColor %>22;color:<%- pColor %>;">
                    <% if(c.aiPriority==='CRITICAL') { %><i class="fas fa-radiation" style="font-size:9px;"></i><% } %>
                    <%= c.aiPriority %>
                </span>
                <div style="font-size:0.7rem;color:var(--text-muted);margin-top:2px;"><%= c.aiCategory %></div>
            </td>
            <td>
                <select class="status-select form-select form-select-sm" data-id="<%= c.id %>"
                    style="font-size:0.78rem;padding:3px 6px;border-radius:6px;color:<%- sColor %>;border-color:<%- sColor %>44;width:130px;">
                    <% ['Pending','Under Review','Resolved','Closed'].forEach(s => { %>
                    <option value="<%= s %>" <%= c.status===s?'selected':'' %>><%= s %></option>
                    <% }) %>
                </select>
            </td>
            <td style="max-width:220px;">
                <div style="font-size:0.8rem;color:var(--text-secondary);line-height:1.4;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">
                    <%= c.complaint %>
                </div>
                <% if(c.officerNote) { %>
                <div style="font-size:0.72rem;color:var(--accent-emerald);margin-top:3px;">
                    <i class="fas fa-note-sticky me-1"></i><%= c.officerNote %>
                </div>
                <% } %>
            </td>
            <td>
                <div class="d-flex gap-1 flex-column">
                    <button class="btn-save-note btn btn-outline-premium btn-sm" data-id="<%= c.id %>"
                        style="font-size:0.72rem;padding:3px 8px;" title="Save status">
                        <i class="fas fa-floppy-disk me-1"></i>Save
                    </button>
                    <button class="btn-delete btn btn-sm" data-id="<%= c.id %>"
                        style="font-size:0.72rem;padding:3px 8px;background:rgba(225,29,72,0.1);color:var(--accent-rose);border:1px solid rgba(225,29,72,0.2);border-radius:8px;" title="Delete report">
                        <i class="fas fa-trash me-1"></i>Delete
                    </button>
                </div>
            </td>
        </tr>
        <% }) %>
        </tbody>
    </table>
    </div>
    <% } %>
</div>

<script>
// Save status
document.querySelectorAll('.btn-save-note').forEach(btn => {
    btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        const row = document.getElementById('row-' + id);
        const status = row.querySelector('.status-select').value;
        try {
            const res = await fetch(`/triage/${id}/status`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status })
            });
            const data = await res.json();
            if (data.success) {
                btn.innerHTML = '<i class="fas fa-check me-1"></i>Saved';
                btn.style.color = 'var(--accent-emerald)';
                btn.style.borderColor = 'var(--accent-emerald)';
                setTimeout(() => {
                    btn.innerHTML = '<i class="fas fa-floppy-disk me-1"></i>Save';
                    btn.style.color = '';
                    btn.style.borderColor = '';
                }, 2000);
            }
        } catch(e) { alert('Failed to update status'); }
    });
});

// Delete report
document.querySelectorAll('.btn-delete').forEach(btn => {
    btn.addEventListener('click', async () => {
        if (!confirm('Delete this report? This cannot be undone.')) return;
        const id = btn.dataset.id;
        try {
            const res = await fetch(`/triage/${id}`, { method: 'DELETE' });
            const data = await res.json();
            if (data.success) {
                document.getElementById('row-' + id).remove();
            }
        } catch(e) { alert('Failed to delete'); }
    });
});
</script>

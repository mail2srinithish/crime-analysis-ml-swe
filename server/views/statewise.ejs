<% layout('/layouts/boilerplate') %>

<div class="page-header animate-in">
    <h1><i class="fas fa-map-location-dot me-2" style="color: var(--accent-cyan);"></i>State Deep Analysis</h1>
    <p class="subtitle">Comprehensive crime profile for <strong><%= stateName %></strong></p>
</div>

<!-- State Selector -->
<div class="glass-card mb-4 animate-in">
    <form method="get" action="/statewise" class="form-premium">
        <div class="row g-3 align-items-end">
            <div class="col-md-9">
                <label class="form-label" for="state">Select State / UT</label>
                <select class="form-select" name="state" id="state">
                    <% stateList.forEach(function(s) { %>
                        <option value="<%= s.code %>" <%= selectedState === s.code ? 'selected' : '' %>><%= s.name %></option>
                    <% }); %>
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn btn-premium w-100" id="statewise-submit">
                    <i class="fas fa-search me-2"></i>Analyse
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-lg-3 col-md-6 animate-in">
        <div class="stat-card blue">
            <div class="stat-icon"><i class="fas fa-gavel"></i></div>
            <div class="stat-value" style="font-size:1.4rem;"><%= ipcReports[ipcReports.length-1]?.toLocaleString('en-IN') || '0' %></div>
            <div class="stat-label">IPC Crimes (2026)</div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 animate-in">
        <div class="stat-card purple">
            <div class="stat-icon"><i class="fas fa-scale-balanced"></i></div>
            <div class="stat-value" style="font-size:1.4rem;"><%= sllReports[sllReports.length-1]?.toLocaleString('en-IN') || '0' %></div>
            <div class="stat-label">SLL Crimes (2026)</div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 animate-in">
        <% const scoreNum = parseFloat(stateScore.safety_score); %>
        <div class="stat-card <%= (!isNaN(scoreNum) && scoreNum > 60) ? 'emerald' : (!isNaN(scoreNum) && scoreNum > 30) ? 'cyan' : 'rose' %>">
            <div class="stat-icon"><i class="fas fa-shield-halved"></i></div>
            <div class="stat-value" style="font-size:1.4rem;"><%= isNaN(scoreNum) ? '—' : stateScore.safety_score %><span style="font-size:0.7rem;">/100</span></div>
            <div class="stat-label">Safety Score</div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 animate-in">
        <div class="stat-card rose">
            <div class="stat-icon"><i class="fas fa-triangle-exclamation"></i></div>
            <div class="stat-value" style="font-size:1.2rem;"><%= stateScore.risk_label %></div>
            <div class="stat-label">Risk Level</div>
        </div>
    </div>
</div>

<!-- Charts -->
<div class="row g-3 mb-4">
    <div class="col-lg-8 animate-in">
        <div class="chart-container">
            <div class="chart-title"><span class="dot blue"></span> Crime Trend — <%= stateName %></div>
            <canvas id="trendChart"></canvas>
        </div>
    </div>
</div>

<!-- Maps and Split -->
<div class="row g-3 mb-4">
    <div class="col-lg-8 animate-in">
        <div class="chart-container">
            <div class="flex-between">
                <div class="chart-title"><span class="dot purple"></span> Deep-Dive District Micro-Hotspots</div>
                <div style="font-size: 0.75rem;"><span class="dot emeral" style="background:#ef4444;"></span> Very High &nbsp; <span class="dot" style="background:#f59e0b;"></span> Med/High</div>
            </div>
            <div id="districtMap" style="height: 350px; border-radius: 8px; z-index: 1;"></div>
        </div>
    </div>
    <div class="col-lg-4 animate-in">
        <div class="chart-container">
            <div class="chart-title"><span class="dot purple"></span> IPC vs SLL Split (2026)</div>
            <canvas id="splitChart" style="max-height: 250px;"></canvas>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6 animate-in">
        <div class="chart-container">
            <div class="chart-title"><span class="dot cyan"></span> Year-over-Year Growth Rate (%)</div>
            <canvas id="growthChart"></canvas>
        </div>
    </div>
    <div class="col-lg-6 animate-in">
        <div class="chart-container">
            <div class="chart-title">
                <span class="dot emerald"></span> ML Prediction (Random Forest)
                <% if(rfPrediction) { %>
                <span style="font-size:0.65rem; padding:2px 6px; border-radius:4px; background:rgba(16,185,129,0.12); color:var(--accent-emerald); margin-left:0.5rem;">
                    <%= rfPrediction.confidence %>
                </span>
                <% } %>
            </div>
            <canvas id="predChart"></canvas>
        </div>
    </div>
</div>

<!-- Data Table -->
<div class="glass-card mb-4 animate-in">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="chart-title mb-0"><span class="dot blue"></span> Yearly Data Table</div>
        <a href="/api/export/csv?state=<%= encodeURIComponent(stateName) %>" class="btn btn-outline-premium btn-sm">
            <i class="fas fa-download me-1"></i> Export CSV
        </a>
    </div>
    <div style="max-height: 300px; overflow-y: auto;">
        <table class="state-table">
            <thead><tr><th>Year</th><th>IPC</th><th>SLL</th><th>Total</th><th>Growth %</th></tr></thead>
            <tbody>
            <% years.forEach(function(y, i) { %>
                <tr>
                    <td><%= y %></td>
                    <td><%= (ipcReports[i] || 0).toLocaleString('en-IN') %></td>
                    <td><%= (sllReports[i] || 0).toLocaleString('en-IN') %></td>
                    <td><%= ((ipcReports[i]||0) + (sllReports[i]||0)).toLocaleString('en-IN') %></td>
                    <td style="color: <%= growthRates[i] > 0 ? 'var(--accent-rose)' : 'var(--accent-emerald)' %>;">
                        <%= growthRates[i] > 0 ? '+' : '' %><%= growthRates[i] %>%
                    </td>
                </tr>
            <% }); %>
            </tbody>
        </table>
    </div>
</div>

<script>
const years = <%- JSON.stringify(years) %>;
const ipcData = <%- JSON.stringify(ipcReports) %>;
const sllData = <%- JSON.stringify(sllReports) %>;
const growthRates = <%- JSON.stringify(growthRates) %>;
const rfPred = <%- JSON.stringify(rfPrediction) %>;

Chart.defaults.color = '#475569';
Chart.defaults.borderColor = 'rgba(0,0,0,0.05)';

// Trend chart
new Chart(document.getElementById('trendChart'), {
    type: 'line',
    data: { labels: years, datasets: [
        { label: 'IPC', data: ipcData, borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,0.1)', fill: true, tension: 0.4, borderWidth: 2 },
        { label: 'SLL', data: sllData, borderColor: '#8b5cf6', backgroundColor: 'rgba(139,92,246,0.08)', fill: true, tension: 0.4, borderWidth: 2 }
    ]},
    options: { responsive: true, interaction: { intersect: false, mode: 'index' },
        plugins: { legend: { position: 'top', labels: { usePointStyle: true } } },
        scales: { y: { ticks: { callback: v => v>=1e6?(v/1e6).toFixed(1)+'M':v>=1e3?(v/1e3).toFixed(0)+'K':v }, grid: { color: 'rgba(0,0,0,0.04)' } }, x: { grid: { display: false } } }
    }
});

// Split pie
new Chart(document.getElementById('splitChart'), {
    type: 'doughnut',
    data: { labels: ['IPC','SLL'], datasets: [{ data: [ipcData[ipcData.length-1], sllData[sllData.length-1]], backgroundColor: ['#3b82f6','#8b5cf6'], borderColor: '#ffffff', borderWidth: 2 }] },
    options: { responsive: true, cutout: '60%', plugins: { legend: { position: 'bottom', labels: { usePointStyle: true } } } }
});

// Growth chart
new Chart(document.getElementById('growthChart'), {
    type: 'bar',
    data: { labels: years, datasets: [{
        label: 'Growth %', data: growthRates,
        backgroundColor: growthRates.map(v => v > 0 ? 'rgba(244,63,94,0.6)' : 'rgba(16,185,129,0.6)'),
        borderRadius: 4
    }]},
    options: { responsive: true, plugins: { legend: { display: false } },
        scales: { y: { ticks: { callback: v => v+'%' }, grid: { color: 'rgba(0,0,0,0.04)' } }, x: { grid: { display: false } } }
    }
});

// Prediction chart
if (rfPred) {
    const allLabels = [...rfPred.historical_years, ...rfPred.future_years];
    const hist = [...rfPred.historical_counts, ...new Array(rfPred.future_years.length).fill(null)];
    const pred = [...new Array(rfPred.historical_counts.length).fill(null), ...rfPred.predictions];
    new Chart(document.getElementById('predChart'), {
        type: 'line',
        data: { labels: allLabels, datasets: [
            { label: 'Historical', data: hist, borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,0.08)', fill: true, tension: 0.4, borderWidth: 2, spanGaps: false },
            { label: 'RF Prediction', data: pred, borderColor: '#f43f5e', backgroundColor: 'rgba(244,63,94,0.08)', fill: true, tension: 0.4, borderWidth: 2.5, borderDash: [8,4], pointRadius: 6, spanGaps: false }
        ]},
        options: { responsive: true, interaction: { intersect: false, mode: 'index' },
            plugins: { legend: { position: 'top', labels: { usePointStyle: true } } },
            scales: { y: { ticks: { callback: v => v>=1e6?(v/1e6).toFixed(1)+'M':v>=1e3?(v/1e3).toFixed(0)+'K':v }, grid: { color: 'rgba(0,0,0,0.04)' } }, x: { grid: { display: false } } }
        }
    });
} else {
    document.getElementById('predChart').parentElement.innerHTML += '<p style="color:var(--text-muted);text-align:center;padding:2rem;">Start the Flask ML server for Random Forest predictions</p>';
}

// District Map Integration
const districtHotspots = <%- JSON.stringify(districtHotspots) %>;
const currentStateName = <%- JSON.stringify(stateName) %>;

// Bounding boxes [minLat, minLng, maxLat, maxLng] for each Indian state/UT
const STATE_BOUNDS = {
    'Andhra Pradesh':           [12.6, 76.8, 19.9, 84.7],
    'Arunachal Pradesh':        [26.7, 91.6, 29.5, 97.4],
    'Assam':                    [24.1, 89.7, 28.2, 96.0],
    'Bihar':                    [24.3, 83.3, 27.5, 88.3],
    'Chhattisgarh':             [17.8, 80.3, 24.1, 84.4],
    'Goa':                      [14.9, 73.7, 15.8, 74.3],
    'Gujarat':                  [20.1, 68.2, 24.7, 74.5],
    'Haryana':                  [27.6, 74.5, 30.9, 77.6],
    'Himachal Pradesh':         [30.4, 75.6, 33.2, 79.0],
    'Jammu and Kashmir':        [32.3, 73.7, 37.1, 78.5],
    'Jharkhand':                [21.9, 83.3, 25.3, 87.9],
    'Karnataka':                [11.6, 74.1, 18.4, 78.6],
    'Kerala':                   [8.3,  74.9, 12.8, 77.4],
    'Madhya Pradesh':           [21.1, 74.0, 26.9, 82.9],
    'Maharashtra':              [15.6, 72.6, 22.0, 80.9],
    'Manipur':                  [23.8, 93.0, 25.7, 94.8],
    'Meghalaya':                [25.0, 89.8, 26.1, 92.8],
    'Mizoram':                  [21.9, 92.3, 24.5, 93.4],
    'Nagaland':                 [25.2, 93.3, 27.1, 95.2],
    'Odisha':                   [17.8, 81.4, 22.6, 87.5],
    'Punjab':                   [29.5, 73.9, 32.5, 76.9],
    'Rajasthan':                [23.1, 69.5, 30.2, 78.2],
    'Sikkim':                   [27.1, 88.0, 28.1, 88.9],
    'Tamil Nadu':               [8.1,  76.2, 13.6, 80.4],
    'Telangana':                [15.8, 77.2, 19.9, 81.1],
    'Tripura':                  [22.9, 91.2, 24.5, 92.4],
    'Uttar Pradesh':            [23.9, 77.1, 30.4, 84.6],
    'Uttarakhand':              [28.7, 77.6, 31.5, 81.0],
    'West Bengal':              [21.5, 85.8, 27.3, 89.9],
    'Delhi':                    [28.4, 76.8, 28.9, 77.4],
    'Chandigarh':               [30.6, 76.7, 30.8, 76.9],
    'Puducherry':               [11.7, 79.6, 12.1, 80.2],
    'Andaman & Nicobar Islands':[6.0,  92.2, 14.0, 94.0],
    'Dadra and Nagar Haveli':   [20.0, 72.9, 20.6, 73.4],
    'Daman and Diu':            [20.3, 72.8, 20.7, 72.9],
    'Lakshadweep':              [10.0, 72.0, 12.0, 74.0]
};

if(districtHotspots && districtHotspots.length > 0) {
    const sb = STATE_BOUNDS[currentStateName] || [8.0, 68.0, 37.0, 97.5];
    const latMin = sb[0], lngMin = sb[1], latMax = sb[2], lngMax = sb[3];
    const latRange = latMax - latMin;
    const lngRange = lngMax - lngMin;

    const mapCenter = [(latMin + latMax) / 2, (lngMin + lngMax) / 2];
    const map = L.map('districtMap').setView(mapCenter, 6);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; OpenStreetMap &copy; CARTO'
    }).addTo(map);

    let bounds = [];
    districtHotspots.forEach(d => {
        // Use real coordinates from server-side lookup; fall back to safe state-bounded scatter
        let lat, lng;
        if (d.lat !== null && d.lat !== undefined && d.lng !== null && d.lng !== undefined) {
            lat = d.lat;
            lng = d.lng;
        } else {
            // Fallback: deterministic scatter within state bounding box
            const chars = d.district.split('');
            const seed1 = chars.reduce((a, c) => (a + c.charCodeAt(0)) % 99991, 0);
            const seed2 = chars.reduce((a, c) => (a * 31 + c.charCodeAt(0)) % 99991, 1);
            lat = latMin + (seed1 / 99991) * latRange;
            lng = lngMin + (seed2 / 99991) * lngRange;
        }

        let color = '#3b82f6';
        if(d.risk_level === 4) color = '#ef4444';
        else if(d.risk_level === 3) color = '#f59e0b';
        else if(d.risk_level === 2) color = '#8b5cf6';

        const marker = L.circleMarker([lat, lng], {
            radius: d.risk_level * 3 + 4,
            fillColor: color,
            color: '#fff',
            weight: 1,
            opacity: 1,
            fillOpacity: 0.8
        }).addTo(map);

        marker.bindPopup(`
            <div style="font-family:Inter;color:#333;">
                <strong>District: ${d.district}</strong><br>
                Risk Level: ${d.risk_label}<br>
                Total Crime: ${d.total_crimes.toLocaleString('en-IN')}
            </div>
        `);
        bounds.push([lat, lng]);
    });
    if(bounds.length > 0) map.fitBounds(bounds, { padding: [50, 50], maxZoom: 9 });
} else {
    document.getElementById('districtMap').innerHTML = '<div style="display:flex;height:100%;align-items:center;justify-content:center;color:var(--text-muted);">No district-level heatmap data available for this state.</div>';
}
</script>

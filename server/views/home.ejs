<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Indian Crime Analysis & ML Prediction System">
    <title>CrimeAnalysis ML - Indian Crime Intelligence</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/stylesheets/app.css">
    <style>
        .hero-section {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
            background: linear-gradient(160deg, #f8fafc 0%, #eef2ff 40%, #f0fdf4 100%);
        }
        .hero-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 2rem;
            position: relative;
            z-index: 2;
        }
        .hero-title {
            font-size: 3.5rem;
            font-weight: 900;
            letter-spacing: -2px;
            line-height: 1.1;
            margin-bottom: 1rem;
            color: #0f172a;
        }
        .hero-title .accent {
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .hero-subtitle {
            font-size: 1.1rem;
            color: var(--text-secondary);
            max-width: 600px;
            margin-bottom: 2rem;
            line-height: 1.7;
        }
        .hero-stats {
            display: flex;
            gap: 3rem;
            margin-top: 3rem;
        }
        .hero-stat {
            text-align: center;
        }
        .hero-stat .value {
            font-size: 2rem;
            font-weight: 800;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .hero-stat .label {
            font-size: 0.75rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 0.25rem;
        }
        .hero-actions {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            justify-content: center;
        }
        .btn-hero {
            padding: 0.85rem 2rem;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 12px;
            transition: all 0.3s ease;
        }
        .btn-hero-primary {
            background: var(--gradient-primary);
            color: white;
            border: none;
        }
        .btn-hero-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(37, 99, 235, 0.3);
            color: white;
        }
        .btn-hero-outline {
            background: transparent;
            color: var(--text-secondary);
            border: 1px solid #e2e8f0;
        }
        .btn-hero-outline:hover {
            border-color: var(--accent-blue);
            color: var(--accent-blue);
            background: rgba(37, 99, 235, 0.04);
        }
        /* Soft decorative shapes */
        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.5;
            animation: float 8s ease-in-out infinite;
        }
        .orb-1 {
            width: 500px; height: 500px;
            background: rgba(37, 99, 235, 0.12);
            top: -15%; right: -10%;
            animation-delay: 0s;
        }
        .orb-2 {
            width: 400px; height: 400px;
            background: rgba(124, 58, 237, 0.1);
            bottom: -15%; left: -10%;
            animation-delay: 3s;
        }
        .orb-3 {
            width: 300px; height: 300px;
            background: rgba(5, 150, 105, 0.08);
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            animation-delay: 5s;
        }
        @keyframes float {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-30px) scale(1.05); }
        }
        .feature-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1.5rem;
            max-width: 900px;
            margin: 3rem auto 0;
        }
        .feature-item {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(0,0,0,0.06);
            border-radius: var(--radius-lg);
            padding: 1.5rem;
            text-align: center;
            transition: all 0.3s ease;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        }
        .feature-item:hover {
            border-color: rgba(37,99,235,0.15);
            transform: translateY(-4px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.08);
        }
        .feature-item i {
            font-size: 1.8rem;
            margin-bottom: 0.75rem;
        }
        .feature-item h5 {
            font-size: 0.9rem;
            font-weight: 700;
            margin-bottom: 0.35rem;
            color: var(--text-primary);
        }
        .feature-item p {
            font-size: 0.78rem;
            color: var(--text-muted);
            margin: 0;
        }
        .hero-footer {
            background: rgba(255,255,255,0.6);
            border-top: 1px solid rgba(0,0,0,0.04);
            padding: 1rem 0;
        }
        .hero-footer span {
            color: var(--text-muted);
            font-size: 0.8rem;
        }
        @media (max-width: 768px) {
            .hero-title { font-size: 2.2rem; }
            .hero-stats { gap: 1.5rem; }
            .hero-stat .value { font-size: 1.5rem; }
        }
    </style>
</head>
<body>
    <div class="hero-section">
        <!-- Animated background orbs -->
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>

        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg navbar-premium">
            <div class="container">
                <a class="navbar-brand" href="/">
                    <i class="fas fa-shield-halved me-2"></i>CrimeAnalysis ML
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#homeNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="homeNav">
                    <div class="navbar-nav ms-auto">
                        <% if(!currentUser){ %>
                        <a class="nav-link" href="/login"><i class="fas fa-right-to-bracket me-1"></i> Login</a>
                        <a class="nav-link" href="/signup"><i class="fas fa-user-plus me-1"></i> Sign Up</a>
                        <% } else { %>
                        <a class="nav-link" href="/dashboard"><i class="fas fa-chart-line me-1"></i> Dashboard</a>
                        <a class="nav-link" href="/logout"><i class="fas fa-right-from-bracket me-1"></i> Logout</a>
                        <% } %>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Hero Content -->
        <div class="hero-content">
            <h1 class="hero-title">
                Indian <span class="accent">Crime Intelligence</span><br>& ML Prediction
            </h1>
            <p class="hero-subtitle">
                Comprehensive crime analytics platform covering 36 States & UTs with IPC and SLL data from 2003-2026, powered by Machine Learning predictions.
            </p>
            <div class="hero-actions">
                <% if(!currentUser){ %>
                <a href="/login" class="btn btn-hero btn-hero-primary">
                    <i class="fas fa-right-to-bracket me-2"></i>Get Started
                </a>
                <a href="/signup" class="btn btn-hero btn-hero-outline">
                    <i class="fas fa-user-plus me-2"></i>Create Account
                </a>
                <% } else { %>
                <a href="/dashboard" class="btn btn-hero btn-hero-primary">
                    <i class="fas fa-chart-line me-2"></i>Open Dashboard
                </a>
                <a href="/predict" class="btn btn-hero btn-hero-outline">
                    <i class="fas fa-brain me-2"></i>ML Predictions
                </a>
                <% } %>
            </div>

            <div class="hero-stats">
                <div class="hero-stat">
                    <div class="value">36</div>
                    <div class="label">States & UTs</div>
                </div>
                <div class="hero-stat">
                    <div class="value">18</div>
                    <div class="label">Years of Data</div>
                </div>
                <div class="hero-stat">
                    <div class="value">IPC+SLL</div>
                    <div class="label">Crime Categories</div>
                </div>
                <div class="hero-stat">
                    <div class="value">ML</div>
                    <div class="label">Prediction Engine</div>
                </div>
            </div>

            <div class="feature-grid">
                <div class="feature-item">
                    <i class="fas fa-map-location-dot" style="color: var(--accent-blue);"></i>
                    <h5>Interactive Map</h5>
                    <p>State-wise heatmap of crime intensity across India</p>
                </div>
                <div class="feature-item">
                    <i class="fas fa-chart-bar" style="color: var(--accent-purple);"></i>
                    <h5>Advanced Analytics</h5>
                    <p>IPC vs SLL comparative analysis with trend charts</p>
                </div>
                <div class="feature-item">
                    <i class="fas fa-brain" style="color: var(--accent-cyan);"></i>
                    <h5>ML Forecasting</h5>
                    <p>Random Forest predictions for future crime trends</p>
                </div>
                <div class="feature-item">
                    <i class="fas fa-file-shield" style="color: var(--accent-emerald);"></i>
                    <h5>Crime Reporting</h5>
                    <p>Secure authenticated portal to file crime reports</p>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <footer class="hero-footer">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-shield-halved me-1"></i> CrimeAnalysis ML</span>
                    <span>&copy; 2026 &bull; MCA Project</span>
                </div>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>